# CivicPulse Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — local development default
MONGO_URI=mongodb://localhost:27017/civicpulse

# JWT — must be at least 32 characters long
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Seed demo accounts, departments and complaints on first startup
# Set to false in production
SEED_DEMO=true
